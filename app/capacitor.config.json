{
  "appId": "lol.iamra.chladni",
  "appName": "Slowtide",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0d120e",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "launchFadeOutDuration": 220,
      "backgroundColor": "#0d120e",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "SocialLogin": {
      "providers": { "apple": true, "google": true, "facebook": false, "twitter": false },
      "logLevel": 1
    }
  }
}
